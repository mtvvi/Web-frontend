# URL для dev-прокси Vite (используется только в режиме разработки)
VITE_API_URL=https://172.20.10.14:8080

# Абсолютный адрес API для production (GitHub Pages, Tauri, PWA). Используйте адрес локальной сети.
VITE_API_BASE_URL=https://172.20.10.14:8080/api

# Путь до MinIO или другого CDN с изображениями услуг
VITE_STORAGE_BASE_URL=https://172.20.10.14:9000

# Публичный путь для GitHub Pages (имя репозитория). Для restinpeace → /restinpeace/
VITE_PUBLIC_PATH=/Web-frontend/

# Включить dev-service-worker (оставьте false, если не нужен оффлайн в npm run dev)
VITE_ENABLE_PWA_DEV=true

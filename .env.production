# Production configuration for GitHub Pages
# Replace with your actual backend URL when deploying

# Base URL for API requests (backend server)
# For GH Pages, this should be your deployed backend URL
VITE_API_BASE_URL=

# Storage URL for images (MinIO or CDN)
VITE_STORAGE_BASE_URL=

# Public path for GitHub Pages (repository name with leading and trailing slashes)
VITE_PUBLIC_PATH=/Web-frontend/

# Enable PWA in production
VITE_ENABLE_PWA_DEV=false

{
  "$schema": "https://schema.tauri.app/config/1.5",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cp .env.tauri .env.local && npm run build",
    "devPath": "https://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "LicenseCalc Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "message": true,
        "confirm": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": [
          "http://192.168.0.120:8080/**",
          "http://192.168.0.120:9000/**",
          "http://localhost:8080/**",
          "http://localhost:9000/**",
          "http://172.20.10.14:8080/**",
          "http://172.20.10.14:9000/**",
          "https://172.20.10.14:8080/**",
          "https://172.20.10.14:9000/**",
          "https://localhost:8080/**",
          "https://localhost:9000/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.LicenseCalc.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "LicenseCalc Desktop",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}